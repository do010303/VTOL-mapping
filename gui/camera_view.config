<!-- Added by examples/VTOL-mapping: what the nadir camera sees, live (the preview camera: same mount and
     field of view as the 15 MP mapping camera, 792 x 528 at 10 Hz). -->
<plugin filename="ImageDisplay" name="Camera view">
  <gz-gui>
    <title>Camera view (nadir, /vtol/camera/preview)</title>
    <property type="string" key="state">docked</property>
  </gz-gui>
  <topic>/vtol/camera/preview</topic>
  <topic_picker>false</topic_picker>
</plugin>
