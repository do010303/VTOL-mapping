<?xml version="1.0"?>
<!-- Generated by scripts/make_models.py (cw30e_sdf): a CW-30E-sized quadplane derived from PX4's standard_vtol.
     Mass 38.0 kg incl. payload, span 4.4 m, length 2.4 m. Do not edit. -->
<sdf version="1.10">
  <model name="cw30e_mapping">
    <pose>0 0 0.560 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>38.0</mass>
        <inertia><ixx>13.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>11.0</iyy><iyz>0</iyz><izz>22.0</izz></inertia>
      </inertial>
      <collision name="skid_left">
        <pose>0 0.45 -0.535 0 0 0</pose>
        <geometry><box><size>1.2 0.05 0.05</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="skid_right">
        <pose>0 -0.45 -0.535 0 0 0</pose>
        <geometry><box><size>1.2 0.05 0.05</size></box></geometry>
        <surface><contact><ode><kp>1000000</kp><kd>100</kd><max_vel>0.1</max_vel><min_depth>0.001</min_depth></ode></contact>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <collision name="fuselage_collision">
        <pose>0.1 0 0 0 0 0</pose>
        <geometry><box><size>1.6 0.32 0.30</size></box></geometry>
      </collision>
      <visual name="fuselage"><pose>0.1 0 0 0 0 0</pose>
        <geometry><box><size>1.6 0.32 0.30</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      <visual name="tail_boom"><pose>-0.95 0 0.05 0 0 0</pose>
        <geometry><box><size>0.9 0.08 0.08</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      <visual name="wing"><pose>0.05 0 0.15 0 0 0</pose>
        <geometry><box><size>0.5 4.4 0.05</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      <visual name="tail"><pose>-1.25 0 0.10 0 0 0</pose>
        <geometry><box><size>0.3 1.2 0.04</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      <visual name="fin"><pose>-1.25 0 0.30 0 0 0</pose>
        <geometry><box><size>0.3 0.04 0.4</size></box></geometry><material><ambient>0.82 0.84 0.86 1</ambient><diffuse>0.82 0.84 0.86 1</diffuse></material></visual>
      <visual name="boom_left"><pose>0 0.72 0.12 0 0 0</pose>
        <geometry><box><size>1.84 0.06 0.06</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="skid_left"><pose>0 0.45 -0.535 0 0 0</pose>
        <geometry><box><size>1.2 0.05 0.05</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="boom_right"><pose>0 -0.72 0.12 0 0 0</pose>
        <geometry><box><size>1.84 0.06 0.06</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="skid_right"><pose>0 -0.45 -0.535 0 0 0</pose>
        <geometry><box><size>1.2 0.05 0.05</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <!-- Mapping payload (scripts/make_models.py): camera above, LiDAR below, under the belly. -->
      <!-- Camera body 100 x 74 x 42.5 mm and lens 61.5 x 36.5 mm (spec 3), lens down. -->
      <visual name="camera_body">
        <pose>0 0 -0.1220 0 0 1.5708</pose>
        <geometry><box><size>0.100 0.074 0.0425</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="camera_lens">
        <pose>0 0 -0.1620 0 0 0</pose>
        <geometry><cylinder><radius>0.03075</radius><length>0.0365</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <!-- Scanner 292 x 162 x 185 mm (spec 2), long side along the track. -->
      <visual name="lidar_body">
        <pose>0 0 -0.3275 0 0 0</pose>
        <geometry><box><size>0.292 0.162 0.185</size></box></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
      <sensor name="nadir_camera" type="camera">
        <pose>0 0 -0.1800 0 1.5707963 0</pose>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <topic>/vtol/camera/image</topic>
        <camera name="ilx_lr1">
          <camera_info_topic>/vtol/camera/camera_info</camera_info_topic>
          <triggered>true</triggered>
          <trigger_topic>/vtol/camera/trigger</trigger_topic>
          <horizontal_fov>0.9432311</horizontal_fov>
          <image><width>4752</width><height>3168</height><format>R8G8B8</format></image>
          <clip><near>1</near><far>4000.0</far></clip>
          <lens>
            <intrinsics><fx>4658.824</fx><fy>4658.824</fy><cx>2375.5</cx><cy>1583.5</cy><s>0</s></intrinsics>
          </lens>
        </camera>
      </sensor>
      <!-- Preview: same mount and field of view as the mapping camera, 1/6 of its resolution, free-running at
           10 Hz, for watching the camera view live (Gazebo GUI, scripts/camera_view.py). Not for mapping. -->
      <sensor name="nadir_camera_preview" type="camera">
        <pose>0 0 -0.1800 0 1.5707963 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/vtol/camera/preview</topic>
        <camera name="preview">
          <!-- Its own info topic: the default (<topic dir>/camera_info) is the mapping camera's. -->
          <camera_info_topic>/vtol/camera/preview/camera_info</camera_info_topic>
          <horizontal_fov>0.9432311</horizontal_fov>
          <image><width>792</width><height>528</height><format>R8G8B8</format></image>
          <clip><near>1</near><far>4000.0</far></clip>
        </camera>
      </sensor>
      <sensor name="nadir_lidar" type="gpu_lidar">
        <!-- Pitched 90 deg: the scan plane is the body y-z plane, the zero angle points down,
             positive angles to the left. -->
        <pose>0 0 -0.4200 0 1.5707963 0</pose>
        <always_on>1</always_on>
        <update_rate>200.0</update_rate>
        <topic>/vtol/lidar/scan</topic>
        <lidar>
          <scan>
            <horizontal><samples>1333</samples><resolution>1</resolution>
              <min_angle>-0.3490659</min_angle><max_angle>0.3490659</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>5.0</min><max>880.0</max><resolution>0.001</resolution></range>
        </lidar>
        <visualize>false</visualize>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.0003394</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.004</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <!-- TODO: update to fix units and coordinate system when we move past Harmonic -->
          <!-- See https://github.com/gazebosim/gz-sim/pull/2460 -->
          <!-- 3mgauss RMS: NOTE: noise is in tesla but sensor reports data in gauss -->
          <!-- Noise modeled after IIS2MDC -->
          <x>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
